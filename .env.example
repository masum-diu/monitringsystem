# Copy these to Vercel → Project → Settings → Environment Variables (Production).
# .env.local is NOT required for deploy and is never uploaded to Vercel.

CRON_SECRET=
RESEND_API_KEY=
MONITOR_EMAIL_FROM=Site Monitor <onboarding@resend.dev>
# One recipient only — single address in MONITOR_EMAIL_TO (no commas)
MONITOR_EMAIL_TO=mmhmasum98@gmail.com
RESEND_TEST_TO=mmhmasum98@gmail.com

# Optional: only used if Vercel cron calls API without ?force=1 (GitHub uses force=1)
# MONITOR_HOURS=0,3,6,9,12,15,18,21
MONITOR_TIMEZONE=Asia/Dhaka

# --- WhatsApp (optional) — site DOWN হলে group/personal-এ alert ---
# Provider: greenapi (group) | callmebot (personal, free)
WHATSAPP_PROVIDER=greenapi
# WHATSAPP_ALERT_ONLY=false → প্রতি ৩ ঘণ্টায় WhatsApp (OK + down)
# শুধু down হলে WhatsApp চাইলে: WHATSAPP_ALERT_ONLY=true
WHATSAPP_ALERT_ONLY=false

# Green API — https://green-api.com (group support)
GREEN_API_URL=https://7105.api.greenapi.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
# Option A: group name (auto lookup) — Ether Alumni group
WHATSAPP_GROUP_NAME=Ether Alumni
# Option B: fixed chat ID (faster; copy from npm run whatsapp:chats)
# WHATSAPP_CHAT_ID=120363417012345678@g.us

# CallMeBot — https://www.callmebot.com/blog/free-api-whatsapp-messages/ (personal only)
# CALLMEBOT_PHONE=8801XXXXXXXXX
# CALLMEBOT_APIKEY=

# GitHub Actions (Repository secret only): CRON_SECRET = same as Vercel
