# Required on Vercel — generate: openssl rand -hex 32
CRON_SECRET=

# Resend (https://resend.com) — create a key and paste it here (not re_xxxxxxxxx placeholder)
RESEND_API_KEY=re_xxxxxxxxx
MONITOR_EMAIL_FROM=Site Monitor <onboarding@resend.dev>
MONITOR_EMAIL_TO=you@example.com
# Optional: recipient for GET /api/email/hello test
RESEND_TEST_TO=mmhmasum98@gmail.com

# Optional: override monitor-sites.json (JSON array)
# MONITOR_SITES=[{"name":"My App","url":"https://myapp.vercel.app"}]

# Optional: hours to run (local time in MONITOR_TIMEZONE), comma-separated
MONITOR_HOURS=10,18
MONITOR_TIMEZONE=Asia/Dhaka
